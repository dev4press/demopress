{
    "compilerOptions": {
        "target": "ES2018",
        "lib": ["ES2018", "DOM"],
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "types": ["vite/client"],
        "strict": true,
        "noEmit": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "verbatimModuleSyntax": true,
        "skipLibCheck": true
    },
    "include": ["src", "vite.config.ts"]
}
